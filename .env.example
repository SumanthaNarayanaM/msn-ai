# MSN AI environment configuration.
# Copy to .env and adjust as needed.

# --- Server ---
MSN_AI_HOST=127.0.0.1
MSN_AI_PORT=8000
MSN_AI_RELOAD=true

# --- Application ---
MSN_AI_APP_NAME=MSN AI
MSN_AI_ENV=development
MSN_AI_DEBUG=true
MSN_AI_VERSION=0.1.0
MSN_AI_LOG_LEVEL=INFO

# --- Paths (defaults resolve relative to the project root) ---
# MSN_AI_DATA_DIR=data
# MSN_AI_MODEL_STORAGE_DIR=model_storage
# MSN_AI_CONVERSATIONS_DIR=data/conversations

# --- Inference ---
# Choose the model provider:
#   mock     -> MockLocalModelProvider (fallback/test, no model needed)
#   llamacpp -> RealLocalModelProvider (llama.cpp backend, use a real GGUF)
#   local    -> alias of llamacpp
MSN_AI_PROVIDER=mock
MSN_AI_MODEL_NAME=mock-msn-ai-v0.1
MSN_AI_MAX_TOKENS=1024
MSN_AI_TEMPERATURE=0.7

# --- Real local model (llama.cpp backend, used when provider=llamacpp|local) ---
# GGUF must exist at MSN_AI_MODEL_PATH. Default location:
#   <model_storage_dir>/base/<MSN_AI_MODEL_HF_FILE>
# TL;DR for the default model: run  scripts\fetch_model.ps1  then set
# MSN_AI_PROVIDER=llamacpp and MSN_AI_MODEL_NAME=qwen2.5-1.5b-instruct.
# MSN_AI_MODEL_PATH=D:/MSN AI/model_storage/base/qwen2.5-1.5b-instruct-q4_k_m.gguf
MSN_AI_N_CTX=2048
# 0 == auto (use all logical CPUs)
MSN_AI_N_THREADS=0
# Hugging Face source used by scripts/fetch_model.ps1
MSN_AI_MODEL_HF_REPO=Qwen/Qwen2.5-1.5B-Instruct-GGUF
MSN_AI_MODEL_HF_FILE=qwen2.5-1.5b-instruct-q4_k_m.gguf

# --- Conversation / memory ---
# Persist every conversation to data/conversations/*.json (true/false)
MSN_AI_SESSION_PERSIST=true
# Long-term memory directory (defaults to data/memory)
# MSN_AI_MEMORY_DIR=data/memory
# MSN AI personality. Override to change behaviour/persona.
# MSN_AI_SYSTEM_PROMPT=You are MSN AI...